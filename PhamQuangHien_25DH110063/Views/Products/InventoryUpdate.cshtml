@model PhamQuangHien_25DH110063.Models.Products

@{
    ViewBag.Title = "Kiểm kê sản phẩm";
}

<h2>Kiểm kê sản phẩm</h2>

@if (TempData["Error"] != null)
{
    <div style="color:red; font-weight:bold; border:1px solid red; padding:10px; margin-bottom:15px;">
        @TempData["Error"]
    </div>
}

<form action="/Products/InventoryUpdate" method="post" style="max-width: 400px;">
    <!-- Trường ẩn lưu ID sản phẩm -->
    <input type="hidden" name="ProductID" value="@Model.ProductID" />

    <div class="form-group" style="margin-bottom:10px;">
        <label>Tên sản phẩm:</label>
        <input type="text" class="form-control" value="@Model.ProductName" readonly />
    </div>

    <div class="form-group" style="margin-bottom:10px;">
        <label>Số lượng tồn hệ thống (hiện tại):</label>
        <input type="text" class="form-control" value="@Model.Quantity" readonly style="background-color:#e9ecef; font-weight:bold;" />
    </div>

    <div class="form-group" style="margin-bottom:15px;">
        <label>Số lượng thực tế (kiểm kê):</label>
        <input type="number" name="actualQuantity" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật kiểm kê</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
</form>