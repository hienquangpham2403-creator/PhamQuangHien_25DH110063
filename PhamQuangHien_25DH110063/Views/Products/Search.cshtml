@model IEnumerable<PhamQuangHien_25DH110063.Models.Products>

@{
    ViewBag.Title = "Tra cứu hàng hóa";
}

<h2>Tra cứu hàng hóa</h2>

<!-- FORM TÌM KIẾM -->
<form method="get" action="/Products/Search" class="form-inline" style="margin-bottom: 20px;">
    Tên SP: <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Nhập tên sản phẩm..." style="margin-right:10px; display:inline-block; width:200px;" />

    Trạng thái:
    <select name="status" class="form-control" style="margin-right:10px; display:inline-block; width:150px;">
        <option value="">-- Tất cả --</option>
        <option value="0" @(ViewBag.Status == 0 ? "selected" : "")>Hết hàng</option>
        <option value="1" @(ViewBag.Status == 1 ? "selected" : "")>Sắp hết</option>
        <option value="5" @(ViewBag.Status == 5 ? "selected" : "")>Đủ hàng</option>
    </select>

    Sắp xếp giá:
    <select name="sortOrder" class="form-control" style="margin-right:10px; display:inline-block; width:150px;">
        <option value="">-- Mặc định --</option>
        <option value="asc" @(ViewBag.SortOrder == "asc" ? "selected" : "")>Giá Tăng dần</option>
        <option value="desc" @(ViewBag.SortOrder == "desc" ? "selected" : "")>Giá Giảm dần</option>
    </select>

    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
</form>

<!-- HIỂN THỊ KẾT QUẢ -->
@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Tình trạng</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>
                    @if (item.Quantity == 0)
                    {<span style="color:red; font-weight:bold;">Hết hàng</span> }
                    else if (item.Quantity >= 1 && item.Quantity <= 4)
                    { <span style="color:orange; font-weight:bold;">Sắp hết</span> }
                    else
                    { <span style="color:green; font-weight:bold;">Đủ hàng</span>}
                </td>
            </tr>
        }
    </table>
}
else
{
    // Yêu cầu: Không có kết quả thì hiển thị thông báo
    <div class="alert alert-warning">
        Không tìm thấy sản phẩm nào phù hợp với điều kiện tra cứu!
    </div>
}